# ==========================================
# CONFIGURATION DU BOT WHATSAPP
# ==========================================

# Nom exact du groupe à modérer (ex: "Mon Groupe WhatsApp")
TARGET_GROUP_NAME=Votre Nom du Groupe

# Nombre d'avertissements avant exclusion (défaut: 3)
MAX_WARNINGS=3

# Méthode d'authentification pour lier votre téléphone:
# "code" = Code d'association par numéro de téléphone (RECOMMANDÉ SUR SERVEUR DISTANT)
# "qr"   = Scanner un QR Code dans le terminal
AUTH_METHOD=code

# Votre numéro de téléphone avec l'indicatif pays (sans le "+", sans espaces ni tirets)
# Exemple France: 33612345678 | Exemple Maroc: 212612345678 | Exemple Algérie: 213551234567
PHONE_NUMBER=
